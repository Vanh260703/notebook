# Tùy chọn. Sao chép thành apps/api/.env khi cần (không commit).
# Chỉ dùng khi chạy API trên host: `pnpm --filter api start:dev`, CLI migration, e2e test.
# Container api không đọc file này.
#
# KHÔNG đặt secret ở đây. APP_PASSWORD, SESSION_SECRET, POSTGRES_PASSWORD nằm ở .env gốc
# và API trên host tự đọc file đó. Giá trị ở file này được ưu tiên hơn .env gốc.

PORT=3001

# Đặt false khi dev qua http mà trình duyệt bỏ cookie Secure: Safari với http://localhost,
# hoặc mở từ điện thoại qua IP LAN (http://192.168.x.x:3000).
# COOKIE_SECURE=false

# Mặc định tự ghép từ POSTGRES_PASSWORD và POSTGRES_HOST_PORT trong .env gốc:
#   DATABASE_URL      -> postgresql://notebook:...@127.0.0.1:<port>/notebook
#   TEST_DATABASE_URL -> postgresql://notebook:...@127.0.0.1:<port>/notebook_test
# Chỉ đặt khi muốn trỏ sang DB khác. Tên DB của e2e PHẢI kết thúc bằng _test (test TRUNCATE dữ liệu).
# Tạo DB test một lần: createdb -U notebook notebook_test (trong container postgres).
# DATABASE_URL=
# TEST_DATABASE_URL=
