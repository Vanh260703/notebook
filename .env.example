# Sao chép thành .env (không commit). Đây là nơi DUY NHẤT chứa secret của dự án.
# Ai đọc file này:
#   - docker compose: tự đọc .env để điền ${...} trong docker-compose.yml (laptop và server ở nhà).
#   - API chạy trên host (start:dev, CLI migration, e2e): cũng đọc file này, xem apps/api/.env.example.
# Sinh giá trị ngẫu nhiên: openssl rand -hex 32

# Mật khẩu PostgreSQL (dùng hex để không phải escape trong URL)
POSTGRES_PASSWORD=change-me-openssl-rand-hex-24

# Mật khẩu đăng nhập app (từ 10 ký tự) và khóa ký cookie (từ 32 ký tự, khác mật khẩu).
# API không khởi động nếu còn giá trị mẫu "change-me...".
# Đổi SESSION_SECRET rồi restart API = đăng xuất mọi thiết bị.
APP_PASSWORD=change-me-at-least-10-chars
SESSION_SECRET=change-me-openssl-rand-hex-32

# Thuộc tính Secure của cookie đăng nhập, mặc định true. Chỉ đặt false khi dev qua http
# mà trình duyệt bỏ cookie Secure (Safari + http://localhost, điện thoại qua IP LAN).
# KHÔNG đặt false trên server.
# COOKIE_SECURE=false

# Chỉ trên laptop: mở port PostgreSQL ra 127.0.0.1 để chạy migration/API trên host.
# KHÔNG bật trên server ở nhà.
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
# Đổi nếu port 5432 trên máy đã bị chiếm. API trên host tự dùng port này để ghép DATABASE_URL.
# POSTGRES_HOST_PORT=5432
